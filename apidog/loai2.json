              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "totalPets": {
                      "type": "integer",
                      "description": "Total number of pets in the system",
                      "example": 150
                    },
                    "availablePets": {
                      "type": "integer",
                      "description": "Number of pets available for adoption",
                      "example": 45
                    },
                    "totalUsers": {
                      "type": "integer",
                      "description": "Total registered users",
                      "example": 1200
                    },
                    "totalOrders": {
                      "type": "integer",
